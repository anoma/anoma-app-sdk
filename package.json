{
  "name": "@anomaorg/anoma-app-sdk",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anoma/anoma-app-sdk.git"
  },
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "main": "dist/index.js",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "./dist/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./primitives": {
      "import": "./dist/primitives.js",
      "require": "./dist/primitives.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm clean && node -p \"'export const ANOMA_APP_SDK_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "pnpm build:ts && pnpm run pack",
    "build:ts": "tsdown",
    "build:arm": "pnpm --filter arm-bindings build",
    "build:arm:dev": "pnpm --filter arm-bindings build:dev",
    "build:docs": "typedoc --plugin typedoc-plugin-markdown --out ./docs src/index.ts",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "tsc-check": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "format": "prettier --write \"{src,arm-bindings/bundled}/**/*.{ts,js,json,css,md}\" \"arm-bindings/*.{js,md,json,yaml}\"",
    "format:check": "prettier --check \"{src,arm-bindings/bundled}/**/*.{ts,js,json,css,md}\" \"arm-bindings/*.{js,md,json,yaml}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "pack": "pnpm pack --pack-destination package/",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anomaorg/arm-bindings": "https://pkg.pr.new/@anomaorg/arm-bindings@e0492f7",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "3.0.0",
    "@scure/base": "1.2.6",
    "bs58": "6.0.0",
    "crc-32": "1.2.2"
  },
  "peerDependencies": {
    "viem": "^2.53.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.12.0",
    "eslint": "^9.36.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.5",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "viem": "2.53.1",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.6",
    "zod": "4.1.13"
  }
}
