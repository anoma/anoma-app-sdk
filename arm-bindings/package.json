{
  "name": "@anomaorg/arm-bindings",
  "version": "0.3.0",
  "description": "Wasm bindings for arm-risc0",
  "license": "Apache-2.0",
  "author": "Anoma",
  "homepage": "https://anoma.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anoma/anoma-app-sdk.git"
  },
  "type": "module",
  "main": "./index",
  "types": "./bundled/dist/index.d.ts",
  "files": [
    "index.js",
    "index.web.js",
    "index.native.js",
    "bundled/dist",
    "generated",
    "cpp",
    "ios",
    "android",
    "ArmBindings.podspec",
    "AnomaorgArmBindingsFramework.xcframework",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:android && pnpm build:ios && pnpm build:web && pnpm build:ts",
    "build:dev": "pnpm clean && pnpm build:ios:dev && pnpm build:android:dev && pnpm build:web:dev",
    "build:android": "ubrn build android --and-generate --release",
    "build:android:dev": "ubrn build android --and-generate",
    "build:ios": "ubrn build ios --and-generate --release",
    "build:ios:dev": "ubrn build ios --and-generate",
    "build:web": "ubrn build web --release",
    "build:web:dev": "ubrn build web",
    "build:ts": "tsdown",
    "clean": "rm -rf generated bundled/dist cpp android ios *.podspec *.xcframework",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "lint:rust": "cargo clippy --manifest-path rust/Cargo.toml --all-targets -- -D warnings",
    "format:check:rust": "cargo fmt --manifest-path rust/Cargo.toml --check"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-5",
    "uniffi-bindgen-react-native": "0.31.0-5"
  },
  "devDependencies": {
    "tsdown": "^0.21.5"
  },
  "peerDependencies": {
    "react-native": ">=0.79"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "ArmBindingsSpec",
    "type": "modules",
    "jsSrcsDir": "generated",
    "outputDir": {
      "ios": "ios/generated"
    },
    "android": {
      "javaPackageName": "net.anoma"
    }
  }
}
