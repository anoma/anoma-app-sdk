{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    // No DOM lib on purpose: this SDK runs under React Native's Hermes as well
    // as the browser, so a reference to window/document/crypto.subtle is a
    // compile error here. Platform-specific code belongs in the consuming app.
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "history/*": ["./src/history/*"],
      "indexer": ["./src/indexer.ts"],
      "keys": ["./src/keys/index.ts"],
      "keys/*": ["./src/keys/*"],
      "payroll": ["./src/payroll/index.ts"],
      "payroll/*": ["./src/payroll/*"],
      "primitives": ["./src/primitives.ts"],
      "resources": ["./src/resources/index.ts"],
      "resources/*": ["./src/resources/*"],
      "tokens": ["./src/tokens/index.ts"],
      "tokens/*": ["./src/tokens/*"],
      "transfer/*": ["./src/transfer/*"],
      "types": ["./src/types.ts"]
    }
  },
  "include": ["src"],
  // Tests are checked by tsconfig.tests.json: they run in Node and need its
  // globals, which must not be visible to the platform-neutral sources above.
  "exclude": ["src/**/tests/**"]
}
